# ──────────────────────────────────────────────
# LegacyKeeper — Environment Configuration
# ──────────────────────────────────────────────

# KeeperHub
KEEPERHUB_API_KEY=kh_your_api_key_here
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp

# Smart Contract
LEGACY_KEEPER_ADDRESS=0x_contract_address_here
RPC_URL=https://sepolia.infura.io/v3/your_project_id
CHAIN_ID=11155111

# Wallet (owner)
OWNER_PRIVATE_KEY=0x_your_private_key_here
OWNER_ADDRESS=0x_your_address_here

# Recovery Key
RECOVERY_PUBLIC_KEY=0x_recovery_public_key_here
SAFE_VAULT_ADDRESS=0x_safe_vault_address_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Discord (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=legacykeeper@yourdomain.com
EMAIL_TO=your_alert_email@example.com

# Liveness Configuration
HEARTBEAT_INTERVAL_SECONDS=86400
TIMEOUT_DURATION_SECONDS=2592000
GRACE_PERIOD_SECONDS=604800
