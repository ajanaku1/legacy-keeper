# ──────────────────────────────────────────────
# LegacyKeeper — Environment Configuration
#
# Copy to .env and fill in. .env is gitignored and must stay that way.
# Every key below is testnet-only. Never put a mainnet key in this file.
# ──────────────────────────────────────────────

# ── KeeperHub ─────────────────────────────────
# app.keeperhub.com → Settings → API Keys → Organisation tab.
# Organisation keys carry the kh_ prefix.
# Alternative: connect an MCP client to https://app.keeperhub.com/mcp and
# authorize it through the browser. This route does not require a copied key.
KEEPERHUB_API_KEY=kh_your_api_key_here
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp
# User-scoped webhook key created for the heartbeat and panic workflows.
KEEPERHUB_WEBHOOK_API_KEY=wfb_your_webhook_key_here
KEEPERHUB_PLAN_WORKFLOW_ID=
KEEPERHUB_CONFIGURATION_WORKFLOW_ID=
KEEPERHUB_HEARTBEAT_WORKFLOW_ID=ryd34r3ayrg2u8o29fmrk
KEEPERHUB_PANIC_WORKFLOW_ID=pm22qhfnox30w0mnngw01

# ── Chain ─────────────────────────────────────
# Any Sepolia endpoint: Alchemy, Infura, or a public RPC.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key_here
CHAIN_ID=11155111
# Current wallet-scoped registry. The deploy script prints this value.
NEXT_PUBLIC_LEGACY_KEEPER_FACTORY_ADDRESS=
# Legacy single-plan tools only; the production dashboard resolves through the
# factory above rather than this environment-wide address.
LEGACY_KEEPER_ADDRESS=

# ── Deployer ──────────────────────────────────
# Burner only — this key deploys the contract via Hardhat.
# Generate one:  npx hardhat console --network sepolia
#                > ethers.Wallet.createRandom().privateKey
DEPLOYER_PRIVATE_KEY=
OWNER_ADDRESS=

# ── Recovery key ──────────────────────────────
# A SECOND, separate key. The whole point of Mode B is that this one still
# works when the owner key is compromised. Generate it the same way, and
# keep it somewhere the owner key is not.
RECOVERY_KEY_ADDRESS=
SAFE_VAULT_ADDRESS=

# ── Etherscan (optional, for contract verification) ──
ETHERSCAN_API_KEY=

# ── Production Telegram identity ──────────────
# Telegram: message @BotFather → /newbot, then configure its HTTPS webhook to
# /api/telegram/webhook with TELEGRAM_WEBHOOK_SECRET as the secret_token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Independent HMAC secret for short-lived unlink and evacuation entry tokens.
TELEGRAM_ACTION_SECRET=
# Independent 32-byte minimum HMAC secret for the seven-day HTTP-only wallet
# session that restores Telegram settings across tabs and deployments.
TELEGRAM_SESSION_SECRET=
# PostgreSQL stores private Telegram identities, wallet links, sessions, and
# idempotent deliveries. Never expose this value to the browser.
DATABASE_URL=postgresql://user:password@host:5432/legacykeeper
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Optional authenticated KeeperHub event intake for plans with HTTP Request
# actions. The free-tier wallet workflows do not depend on this callback;
# dashboard-originated actions notify Telegram after receipt verification.
LEGACYKEEPER_KEEPERHUB_EVENT_URL=http://127.0.0.1:3000/api/integrations/keeperhub/events
KEEPERHUB_EVENTS_SECRET=

# ── Legacy local agent alerts ─────────────────
# Only the optional standalone `npm run agent:bot` process uses this fixed chat.
# Production wallet-scoped dashboard delivery never reads it.
TELEGRAM_CHAT_ID=

# Discord (optional): Server Settings → Integrations → Webhooks.
DISCORD_WEBHOOK_URL=

# ── Liveness defaults ─────────────────────────
# Deployment scripts may override these explicitly for a testnet demo.
HEARTBEAT_INTERVAL_SECONDS=86400
TIMEOUT_DURATION_SECONDS=2592000
GRACE_PERIOD_SECONDS=604800
