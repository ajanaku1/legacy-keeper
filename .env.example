# ──────────────────────────────────────────────
# LegacyKeeper — Environment Configuration
#
# Copy to .env and fill in. .env is gitignored and must stay that way.
# Every key below is testnet-only. Never put a mainnet key in this file.
# ──────────────────────────────────────────────

# ── KeeperHub ─────────────────────────────────
# app.keeperhub.com → Settings → API Keys → Organisation tab.
# Organisation keys carry the kh_ prefix.
# Alternative (no key needed): claude mcp add --transport http keeperhub \
#   https://app.keeperhub.com/mcp   → authorises over OAuth in the browser.
KEEPERHUB_API_KEY=kh_your_api_key_here
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp

# ── Chain ─────────────────────────────────────
# Any Sepolia endpoint: Alchemy, Infura, or a public RPC.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key_here
CHAIN_ID=11155111
LEGACY_KEEPER_ADDRESS=

# ── Deployer ──────────────────────────────────
# Burner only — this key deploys the contract via Hardhat.
# Generate one:  npx hardhat console --network sepolia
#                > ethers.Wallet.createRandom().privateKey
DEPLOYER_PRIVATE_KEY=
OWNER_ADDRESS=

# ── Recovery key ──────────────────────────────
# A SECOND, separate key. The whole point of Mode B is that this one still
# works when the owner key is compromised. Generate it the same way, and
# keep it somewhere the owner key is not.
RECOVERY_KEY_ADDRESS=
SAFE_VAULT_ADDRESS=

# ── Etherscan (optional, for contract verification) ──
ETHERSCAN_API_KEY=

# ── Alerts ────────────────────────────────────
# Telegram: message @BotFather → /newbot. Chat ID: message @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord (optional): Server Settings → Integrations → Webhooks.
DISCORD_WEBHOOK_URL=

# ── Liveness (production defaults) ────────────
# The dashboard's Demo Mode overrides these with seconds-scale values so the
# full lifecycle is filmable; these are what a real deployment would use.
HEARTBEAT_INTERVAL_SECONDS=86400
TIMEOUT_DURATION_SECONDS=2592000
GRACE_PERIOD_SECONDS=604800
