{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": [
    "agent/**/*.ts",
    "bot/**/*.ts",
    "scripts/**/*.ts",
    "starter/**/*.ts",
    "test/**/*.ts",
    "hardhat.config.ts"
  ],
  "exclude": ["node_modules", "dist", "dashboard"]
}
