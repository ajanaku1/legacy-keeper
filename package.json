{
  "name": "legacy-keeper",
  "version": "0.1.0",
  "description": "LegacyKeeper is a verifiable autonomous continuity agent that monitors wallet liveness, coordinates sponsored execution through KeeperHub, and proves every outcome onchain.",
  "private": true,
  "scripts": {
    "test": "hardhat test",
    "test:agent": "vitest run",
    "test:dashboard": "vitest run --config dashboard/vitest.config.ts",
    "compile": "hardhat compile",
    "node": "hardhat node",
    "verify:all": "bash verify.sh",
    "format": "prettier --write '**/*.ts' '**/*.sol'",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "first-tx": "tsx starter/first-transaction.ts",
    "first-tx:dry-run": "tsx starter/first-transaction.ts --dry-run",
    "agent": "tsx agent/run.ts",
    "agent:bot": "tsx agent/run.ts --with-bot",
    "evidence:keeperhub-1841": "tsx scripts/workflows/retest-execute-natural-encoding.ts --write",
    "workflows:deploy": "tsx scripts/workflows/deploy.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "ethers": "^6.13.0",
    "node-telegram-bot-api": "^0.66.0",
    "nodemailer": "^6.9.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^20.14.0",
    "@types/node-telegram-bot-api": "^0.64.0",
    "@types/nodemailer": "^6.4.0",
    "hardhat": "^2.22.0",
    "prettier": "^3.3.0",
    "solc": "^0.8.24",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
